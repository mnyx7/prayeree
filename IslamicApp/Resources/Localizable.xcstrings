    "Tap a number to enter minutes, or use minus and plus for one-minute changes. Adjust up to 60 minutes earlier or later." : {
      "comment" : "A footer for the prayer adjustment section.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dəqiqələri daxil etmək üçün ədədə toxunun və ya bir dəqiqəlik dəyişikliklər üçün mənfi və müsbət düymələrindən istifadə edin. Vaxtı 60 dəqiqəyədək daha tez və ya daha gec təyin edin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на число, чтобы ввести минуты, или используйте минус и плюс для изменения на одну минуту. Можно сдвинуть время на 60 минут раньше или позже."
          }
        }
      }
    },
    "Tap to enter minutes" : {
      "comment" : "A hint for the user to tap a number to enter minutes.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dəqiqələri daxil etmək üçün toxunun"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите, чтобы ввести минуты"
          }
        }
      }
    },
    "Translation credits appear with Quran content. Text and translations belong to their respective rights holders." : {
      "comment" : "A footer for the About Us screen.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tərcümə müəllifləri Quran mətni ilə birlikdə göstərilir. Mətn və tərcümələr müvafiq hüquq sahiblərinə məxsusdur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сведения о переводчиках указаны рядом с текстом Корана. Права на тексты и переводы принадлежат их правообладателям."
          }
        }
      }
    },
