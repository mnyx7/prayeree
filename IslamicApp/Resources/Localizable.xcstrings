    "settings.minber_explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم جدول مواقيت الصلاة المنشور للمدينة الأذربيجانية المختارة من إدارة مسلمي القوقاز عبر Minber.az. لا يغيّر اختيار المذهب هذا الجدول الثابت. يُحفظ تفضيل المذهب للطرق الأخرى."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minber.az vasitəsilə seçilmiş Azərbaycan şəhəri üçün dərc olunmuş QMİ cədvəlindən istifadə edilir. Məzhəb seçimi bu sabit cədvəli dəyişmir. Məzhəb seçiminiz digər üsullar üçün saxlanılır."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the selected Azerbaijani city’s published QMİ timetable via Minber.az. Madhab selection does not change this fixed timetable. Your madhab preference is kept for other methods."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется опубликованное расписание Управления мусульман Кавказа для выбранного города Азербайджана через Minber.az. Выбор мазхаба не меняет это фиксированное расписание. Ваш мазхаб сохраняется для других методов."
          }
        }
      }
    },
