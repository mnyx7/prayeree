    "settings.sunrise_reminder_info" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunrise has its own optional reminder. Open the app regularly to refresh the seven-day reminder schedule."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للشروق تذكير اختياري مستقل. افتح التطبيق بانتظام لتحديث جدول التذكيرات للأيام السبعة المقبلة."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для восхода можно включить отдельное напоминание. Регулярно открывайте приложение, чтобы обновлять расписание на семь дней."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günəşin doğması üçün ayrıca bildiriş seçə bilərsiniz. Yeddi günlük bildiriş cədvəlini yeniləmək üçün tətbiqi müntəzəm açın."
          }
        }
      }
    },
