    "prayer_times.countdown_accessibility_format" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "الصلاة القادمة: %1$@ خلال %2$lld دقائق"
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "الصلاة القادمة: %1$@ خلال %2$lld دقيقة"
                }
