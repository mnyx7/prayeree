{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.sunrise_about" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunrise appears between Fajr and Dhuhr and has an optional reminder. The next-prayer countdown follows the five daily prayers."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر الشروق بين الفجر والظهر وله تذكير اختياري. يتبع العد التنازلي للصلاة التالية الصلوات الخمس اليومية."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восход отображается между фаджром и зухром; для него можно включить напоминание. Обратный отсчёт относится к пяти ежедневным намазам."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günəşin doğması Sübh və Zöhr arasında göstərilir və ayrıca bildiriş seçimi var. Növbəti namaza geri sayım beş gündəlik namaza əsaslanır."
          }
        }
      }
    },
    "settings.minber_source_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minber.az is a third-party source for QMİ-based city timetables."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minber.az مصدر خارجي لجداول المدن المستندة إلى بيانات إدارة مسلمي القوقاز."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minber.az — сторонний источник расписаний по городам на основе данных Управления мусульман Кавказа (QMİ)."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minber.az QMİ məlumatlarına əsaslanan şəhər təqvimlərini təqdim edən üçüncü tərəf mənbəyidir."
          }
        }
      }
    },
